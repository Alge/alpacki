// Add EOS padding to align to octet boundary
fn add_eos_padding(accumulated: BitArray) -> BitArray {
  let remainder = bit_array.bit_size(accumulated) % 8
  case remainder {
    0 -> accumulated
    _ -> {
      let bits_to_add = 8 - remainder
      let padding = ones(bits_to_add)
      <<accumulated:bits, padding:size(bits_to_add)>>
    }
  }
}

// Returns N bits of 1s
fn ones(n: Int) -> Int {
  case n {
    1 -> 0b1
    2 -> 0b11
    3 -> 0b111
    4 -> 0b1111
    5 -> 0b11111
    6 -> 0b111111
    7 -> 0b1111111
    _ -> 0
  }
}
